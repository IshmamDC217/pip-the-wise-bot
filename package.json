{
  "name": "forgerealm-discord-bot",
  "version": "1.0.0",
  "description": "Discord bot for monitoring ForgeRealm — website, shop, and API health",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "register": "tsx src/commands/index.ts",
    "ready": "tsx scripts/ready-page.tsx",
    "mcp": "tsx src/mcp/server.ts",
    "service:install": "npm run build && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows-service/install.ps1",
    "service:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows-service/uninstall.ps1",
    "service:logs": "powershell -NoProfile -Command \"Get-Content -Path logs/stdout.log -Tail 50 -Wait\"",
    "service:logs:err": "powershell -NoProfile -Command \"Get-Content -Path logs/stderr.log -Tail 50 -Wait\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.7",
    "googleapis": "^171.4.0",
    "mysql2": "^3.11.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.2"
  }
}
